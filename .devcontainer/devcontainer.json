{
  // Nome container
  "name": "E-Commerce Backand",

  // Metodo de criação da imagem
  "build": {
    // Nome do arquivo que contem a configuração de criação de imagem
    "dockerfile": "Dockerfile"
  },

  // Libera as portas do container
  // 8080 - Spring
  // 3306 - MySQL
  "forwardPorts": [8080, 3306],

  // Define as custumizações
  "customizations": {
    // Custumizações referentes ao vscode
    "vscode": {
      // Expecifica as extensões que serão instaladas
      "extensions": [
        "ms-azuretools.vscode-docker",  // Docker
        "vscjava.vscode-java-pack", // Java
        "vmware.vscode-spring-boot", // Spring Boot  
        "vscjava.vscode-spring-initializr", // Spring Initializr 
        "vscjava.vscode-spring-boot-dashboard", // Dashboard de apps
        "cweijan.vscode-mysql-client2"  // MySQL
      ],

      // Define configurações visuais e de ambiente do vscode
      "settings": {
        "workbench.colorTheme": "Dark Modern",  // Tema
        "editor.fontSize": 16,  // Fonte do editor    
        "terminal.integrated.fontSize": 14, // Fonte do terminal 
        "java.server.launchMode": "Standard" // Executa o Java em modo "normal"
      }
    }
  },

  // Executa o comando definido na criação do container
  "postCreateCommand": "/bin/bash .devcontainer/init-mysql.sh",

  // Executa o cmando especificado na inicialização do container
  "postStartCommand": "service mysql start"
}
